# OpenWatch runs with no keys at all. Each key below switches one more feed on (free sign-ups).

# ---- host
OPENWATCH_HTTPS_PORT=39443
OPENWATCH_HTTP_PORT=39080
# Public site name: automatic HTTPS (Let's Encrypt). e.g. 34-10-20-30.sslip.io or openwatch.example.org
OPENWATCH_SITE=localhost
# Image tag to pull (latest = newest main)
OPENWATCH_TAG=latest
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=admin
# Grafana Cloud (servers): set by scripts/deploy/grafana-cloud.sh; enables the `cloud` profile (Alloy only)
# COMPOSE_PROFILES=cloud
# GRAFANA_CLOUD_PROM_URL=
# GRAFANA_CLOUD_PROM_USER=
# GRAFANA_CLOUD_LOKI_URL=
# GRAFANA_CLOUD_LOKI_USER=
# GRAFANA_CLOUD_TOKEN=

# ---- coverage: india (default). "global" (worldwide aircraft, ships, quakes, news) is upcoming/experimental.
OPENWATCH_SCOPE=india

# ---- storage (0 = keep forever)
OPENWATCH_RETENTION_DAYS=0
OPENWATCH_RAW_RETENTION_DAYS=90
OPENWATCH_MAX_EXPORT_DAYS=31
# Bulk data export and archive search: off for now (paid access coming)
OPENWATCH_EXPORT_ENABLED=false
# Run only some feeds (comma separated ids); empty = all
OPENWATCH_FEEDS=

# ---- feed keys
# Ships: https://aisstream.io (free)
AISSTREAM_KEY=
# Fires: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (free)
FIRMS_MAP_KEY=
# Air quality (CPCB): https://data.gov.in (free account → API key)
DATA_GOV_IN_KEY=
# NOTAM fallback: https://api.faa.gov (free)
FAA_NOTAM_KEY=
# Road traffic layer + incidents: https://developer.tomtom.com (free tier)
TOMTOM_KEY=
# Many more aircraft: free OpenSky account → Account → API client (polls every 90 s instead of 15 min)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
