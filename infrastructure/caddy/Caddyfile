# Caddy: TLS (automatic Let's Encrypt for a public name, internal CA for localhost), compression, routing.
# OPENWATCH_SITE = the site address, e.g. 34-10-20-30.sslip.io or openwatch.example.org (default: localhost)
{$OPENWATCH_SITE:localhost} {
	# compresses JSON and the SSE live stream too (keeps a small server inside its free egress)
	encode zstd gzip

	# access log (JSON) on the persistent caddy_data volume, so visitor history survives container restarts and
	# updates; rotated at 20 MB, kept 90 days. Visitor report: scripts/deploy/stats.sh
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep_for 2160h
		}
		format json
	}

	# optional extras such as basic auth: drop a file matching this glob into the container (see docs/deploy.md)
	import /etc/caddy/extra*.caddy

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		# map tiles, glyphs and imagery come from OpenFreeMap, NASA GIBS and AWS terrain; MapLibre runs workers from blob:
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://gibs.earthdata.nasa.gov; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org https://gibs.earthdata.nasa.gov https://s3.amazonaws.com; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Prometheus scrapes services directly on the compose network
	respond /metrics 404

	# the browser only talks to the backend for frontend; the core API stays on the compose network
	handle /ui/* {
		reverse_proxy bff:8000 {
			# SSE: deliver each event as it's written
			flush_interval -1
		}
	}
	# self-hosters who want the raw API (scripts, /api/docs): OPENWATCH_PUBLIC_API=true
	@publicapi {
		path /api/*
		expression "{$OPENWATCH_PUBLIC_API:false}" == "true"
	}
	handle @publicapi {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy frontend:80
	}
}
