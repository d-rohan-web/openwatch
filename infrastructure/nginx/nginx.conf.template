# Rendered by the nginx image's envsubst at start (/etc/nginx/templates → conf.d).
# TLS from certs-init (self-signed) unless real certs are mounted at /etc/nginx/certs.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    return 301 https://$host:${OPENWATCH_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    client_max_body_size 1m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Optional basic auth for a hosted box: mount an htpasswd file and set OPENWATCH_AUTH="OpenWatch".
    auth_basic ${OPENWATCH_AUTH};
    auth_basic_user_file /etc/nginx/htpasswd;

    resolver 127.0.0.11 valid=10s;
    set $api http://api:8000;
    set $web http://frontend:80;

    location = /api/stream {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE: deliver each event as it is written
        proxy_read_timeout 1h;
    }
    location /api/export {
        proxy_pass $api;
        proxy_read_timeout 15m;       # big windows take a while to assemble
        proxy_max_temp_file_size 0;
    }
    location /api/ {
        proxy_pass $api;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /metrics { return 404; }  # Prometheus scrapes services directly on the compose network
    location / {
        proxy_pass $web;
    }
}
