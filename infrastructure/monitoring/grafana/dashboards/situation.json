  {
   "type": "timeseries",
   "title": "Active alerts by severity",
   "description": "All sources: IMD, SACHET, INCOIS, CWC, NCS, NAVAREA, CERT-In …",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum by (severity) (openwatch_live_severity{severity=~\"advisory|warning|critical\", instance=~\"$instance\"})",
     "legendFormat": "{{severity}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 18,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "advisory"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ffd23f"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "warning"
      },
      "properties": [
