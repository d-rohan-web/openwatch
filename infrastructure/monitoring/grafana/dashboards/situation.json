{
 "uid": "openwatch-situation",
 "title": "OpenWatch · Situation",
 "description": "How the situation in India changes over time",
 "tags": [
  "openwatch"
 ],
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "prom",
    "label": "Metrics",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
   },
   {
    "name": "loki",
    "label": "Logs",
    "type": "datasource",
    "query": "loki",
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Site",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${prom}"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "query": {
     "query": "label_values(openwatch_live_records, instance)",
     "refId": "v"
    },
    "definition": "label_values(openwatch_live_records, instance)"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Critical now",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(openwatch_live_severity{severity=\"critical\", instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       },
       {
        "color": "#ff4d4f",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
