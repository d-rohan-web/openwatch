  {
   "type": "logs",
   "title": "Recent visitors",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "{job=\"access\", instance=~\"$instance\"} | json uri=\"request.uri\", status=\"status\", ref=\"request.headers.Referer[0]\" | uri !~ \"^/(api|assets|geo)/.*\" | line_format \"{{.country}} · {{.city}}   {{.browser}} / {{.os}} ({{.device}})   {{.status}} {{.uri}}   ← {{.ref}}\"",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 17,
   "gridPos": {
    "x": 0,
    "y": 53,
    "w": 24,
    "h": 10
   }
  }
 ],
