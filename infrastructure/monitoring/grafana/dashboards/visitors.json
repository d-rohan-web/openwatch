  },
  {
   "type": "timeseries",
   "title": "Response time p95 (excl. live stream)",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "quantile_over_time(0.95, {job=\"access\", instance=~\"$instance\"} | json uri=\"request.uri\", duration=\"duration\" | uri !~ \"/api/stream.*\" | unwrap duration [5m]) by (instance)",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
