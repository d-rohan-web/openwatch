   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
