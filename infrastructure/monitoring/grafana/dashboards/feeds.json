{
 "uid": "openwatch-feeds",
 "title": "OpenWatch feeds",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Records received / min",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (feed) (rate(openwatch_records_total[5m])) * 60",
     "legendFormat": "{{feed}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Records archived / min",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (feed) (rate(openwatch_records_stored_total[5m])) * 60",
     "legendFormat": "{{feed}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Fetch errors / hour",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (feed) (rate(openwatch_fetch_total{result=\"error\"}[30m])) * 3600",
     "legendFormat": "{{feed}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Seconds since last good fetch",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "time() - openwatch_last_ok_timestamp",
     "legendFormat": "{{feed}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Live records",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "openwatch_live_records",
     "legendFormat": "{{feed}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Exports",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (format) (increase(openwatch_exports_total[1h]))",
     "legendFormat": "{{format}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Warnings and errors",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{level=~\"WARNING|ERROR\"}"
    }
   ]
  }
 ]
}