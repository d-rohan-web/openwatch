{
 "uid": "openwatch-overview",
 "title": "OpenWatch · Overview",
 "description": "Feeds, archive and visitors at a glance",
 "tags": [
  "openwatch"
 ],
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "prom",
    "label": "Metrics",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
   },
   {
    "name": "loki",
    "label": "Logs",
    "type": "datasource",
    "query": "loki",
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Site",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${prom}"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "query": {
     "query": "label_values(openwatch_live_records, instance)",
     "refId": "v"
    },
    "definition": "label_values(openwatch_live_records, instance)"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Feeds healthy",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "count(openwatch_feed_failing{instance=~\"$instance\"} == 0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Feeds failing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(openwatch_feed_failing{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       },
       {
        "color": "#ffd23f",
        "value": 1
       },
       {
        "color": "#ff4d4f",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Live records",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(openwatch_live_records{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#7fd3ff",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Archived · 24 h",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(increase(openwatch_records_stored_total{instance=~\"$instance\"}[24h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#b69cff",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Visitors · 24 h",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "count(sum by (ip) (count_over_time({job=\"access\", instance=~\"$instance\"} | json ip=\"request.remote_ip\" [24h])))",
     "legendFormat": "",
     "refId": "A",
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#ff9933",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Data served · 24 h",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "sum(sum_over_time({job=\"access\", instance=~\"$instance\"} | json size=\"size\" | unwrap size [24h]))",
     "legendFormat": "",
     "refId": "A",
     "queryType": "instant"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#38bdf8",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 6,
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "table",
   "title": "Feed health",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "max by (feed) (openwatch_feed_failing{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "max by (feed) (openwatch_live_records{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "time() - max by (feed) (openwatch_last_ok_timestamp{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum by (feed) (increase(openwatch_fetch_total{result=\"error\", instance=~\"$instance\"}[1h]))",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "Failing",
       "Value #B": "Live records",
       "Value #C": "Since last OK",
       "Value #D": "Errors · 1 h"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Failing",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Since last OK"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failing"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "OK",
            "color": "#22d3a6"
           },
           "1": {
            "text": "FAILING",
            "color": "#ff4d4f"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     }
    ]
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 10
   }
  },
  {
   "type": "timeseries",
   "title": "Records received / min",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum by (feed) (rate(openwatch_records_total{instance=~\"$instance\"}[5m])) * 60",
     "legendFormat": "{{feed}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 18,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Fetch errors / 15 min",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum by (feed) (increase(openwatch_fetch_total{result=\"error\", instance=~\"$instance\"}[15m])) > 0",
     "legendFormat": "{{feed}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 9,
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "logs",
   "title": "Warnings & errors",
   "datasource": {
    "type": "loki",
    "uid": "${loki}"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "${loki}"
     },
     "expr": "{level=~\"WARNING|ERROR\", instance=~\"$instance\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "id": 10,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 9
   }
  }
 ],
 "editable": true,
 "links": [
  {
   "title": "OpenWatch dashboards",
   "type": "dashboards",
   "tags": [
    "openwatch"
   ],
   "asDropdown": true
  }
 ]
}