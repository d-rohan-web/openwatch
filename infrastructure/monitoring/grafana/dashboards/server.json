{
 "uid": "openwatch-server",
 "title": "OpenWatch · Server health",
 "description": "The VM: CPU, memory, swap, disk and network",
 "tags": [
  "openwatch"
 ],
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "prom",
    "label": "Metrics",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0
   },
   {
    "name": "loki",
    "label": "Logs",
    "type": "datasource",
    "query": "loki",
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Site",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${prom}"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "query": {
     "query": "label_values(openwatch_live_records, instance)",
     "refId": "v"
    },
    "definition": "label_values(openwatch_live_records, instance)"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       },
       {
        "color": "#ffd23f",
        "value": 0.7
       },
       {
        "color": "#ff4d4f",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Memory used",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "1 - avg(node_memory_MemAvailable_bytes{instance=~\"$instance\"}) / avg(node_memory_MemTotal_bytes{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       },
       {
        "color": "#ffd23f",
        "value": 0.8
       },
       {
        "color": "#ff4d4f",
        "value": 0.92
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Swap used",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "avg(node_memory_SwapTotal_bytes{instance=~\"$instance\"} - node_memory_SwapFree_bytes{instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#b69cff",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Disk used",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "1 - min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\", instance=~\"$instance\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\", instance=~\"$instance\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#22d3a6",
        "value": null
       },
       {
        "color": "#ffd23f",
        "value": 0.75
       },
       {
        "color": "#ff4d4f",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   }
  },
  {
   "type": "timeseries",
   "title": "CPU",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$instance\"}[5m]))",
     "legendFormat": "busy",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Memory",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "avg(node_memory_MemTotal_bytes{instance=~\"$instance\"} - node_memory_MemAvailable_bytes{instance=~\"$instance\"})",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "avg(node_memory_SwapTotal_bytes{instance=~\"$instance\"} - node_memory_SwapFree_bytes{instance=~\"$instance\"})",
     "legendFormat": "swap used",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 6,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Network",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\", instance=~\"$instance\"}[5m]))",
     "legendFormat": "out",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\", instance=~\"$instance\"}[5m]))",
     "legendFormat": "in",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Load average",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${prom}"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "avg(node_load1{instance=~\"$instance\"})",
     "legendFormat": "1 min",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${prom}"
     },
     "expr": "avg(node_load5{instance=~\"$instance\"})",
     "legendFormat": "5 min",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8,
      "gradientMode": "opacity",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   }
  }
 ],
 "editable": true,
 "links": [
  {
   "title": "OpenWatch dashboards",
   "type": "dashboards",
   "tags": [
    "openwatch"
   ],
   "asDropdown": true
  }
 ]
}